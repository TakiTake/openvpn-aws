# Pinned upstream versions. The watch-upstream workflow opens a PR when
# either falls behind; CI proves the patch still applies and builds.
OPENVPN_VERSION=2.7.7
OPENVPN_SHA256=3ab8f48fd6c26d49ba2333a092433949afdb5c85c0e6a1ff265784fbc04a2463
# OpenSSL is statically linked from Homebrew's openssl@3 at build time.
# This records the version used by the latest release so the watcher can
# detect when a rebuild is warranted (e.g. an OpenSSL security update).
LAST_BUILT_OPENSSL=3.6.3
